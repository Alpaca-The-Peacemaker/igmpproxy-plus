{
	"luci-app-igmpproxy-plus": {
		"description": "Grant access to igmpproxy-plus settings and status",
		"read": {
			"file": {
				"/usr/sbin/igmpproxy -S": [
					"exec"
				],
				"/usr/sbin/igmpproxy -E": [
					"exec"
				]
			},
			"ubus": {
				"file": [
					"exec"
				],
				"luci-rpc": [
					"getDHCPLeases"
				]
			},
			"uci": [
				"igmpproxy"
			]
		},
		"write": {
			"uci": [
				"igmpproxy"
			],
			"file": {
				"/usr/sbin/igmpproxy -Q": [
					"exec"
				]
			},
			"ubus": {
				"file": [
					"exec"
				]
			}
		}
	}
}
